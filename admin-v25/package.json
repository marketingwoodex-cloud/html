{
  "name": "woodex-admin-v25",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "description": "Woodex Admin v2.5 Pro — the admin dashboard (React 18 + TypeScript) over api/v2. See ../ADMIN-V2.5-MASTER-PLAN-2026-10-13.md",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "dev:api": "node ../tools/phpwasm/serve.cjs --port 8080",
    "db:init": "cd .. && WX_HOST_FS=1 node tools/phpwasm/run-php.cjs db/migrate.php --sqlite-init",
    "db:owner": "cd .. && WX_HOST_FS=1 node tools/phpwasm/run-php.cjs db/owner.php",
    "db:seed": "node ../tools/seed-dev.mjs",
    "dashboard:verify": "python3 ../tools/verify-dashboard.py --stale-check --rules-check",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "smoke": "vite build --ssr src/smoke.tsx --outDir .smoke --logLevel warn && node .smoke/smoke.js",
    "verify": "npm run typecheck && npm run smoke && npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
