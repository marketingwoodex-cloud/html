 {
  "id": "9947d53e57",
  "type": "hero",
  "html": "\n    <section class=\"hero\" aria-labelledby=\"hero-title\">\n      <div class=\"hero-bg\"><img src=\"/assets/img/img-c349a92a4ae0.webp\" alt=\"Photorealistic 3D interior render of a contemporary living room with warm timber detailing\" width=\"2240\" height=\"1120\" loading=\"lazy\" decoding=\"async\"></div>\n      <div class=\"wrap hero-inner\">\n        <nav class=\"crumbs\" aria-label=\"Breadcrumb\"><a href=\"/\">Home</a><span>→</span><span>Services</span><span>→</span><span>3D Visualization Studio</span></nav>\n        <p class=\"eyebrow light\">Independent visualization, made in house</p>\n        <h1 id=\"hero-title\">3D Visualization Studio in Lahore</h1>\n        <p class=\"lead\">Photorealistic renders, walkthroughs, virtual tours and shadow studies made in house for clearer decisions before construction.</p>\n        <div class=\"actions\"><a class=\"btn\" href=\"#brief\">Start a brief</a><a class=\"btn btn-light\" href=\"#work\">View a 3D study</a></div>\n        <div class=\"trust\" aria-label=\"Studio highlights\"><span>In House 3ds Max</span><span>2 to 5 Day Turnaround</span><span>Ready for Marketing</span><span>External Clients Welcome</span></div>\n      </div>\n    </section>",
  "fields": {
   "heading": "3D Visualization Studio in Lahore",
   "cta_text": "Start a brief",
   "cta_href": "#brief",
   "img_src": "/assets/img/img-c349a92a4ae0.webp",
   "img_alt": "Photorealistic 3D interior render of a contemporary living room with warm timber detailing"
  }
 },
 {
  "id": "6f00156d6c",
  "type": "raw",
  "html": "\n\n    <section class=\"section about-section\" id=\"about\"><div class=\"wrap\">\n      <header class=\"about-heading\" data-anim=\"\">\n        <p class=\"eyebrow kicker-line\">A clearer view, before the build</p>\n        <h2>What Is 3D Visualization?</h2>\n      </header>\n      <div class=\"about-layout\">\n        <figure class=\"media about-media\" data-anim=\"\"><img src=\"/assets/img/img-dce06249b137.webp\" alt=\"Photorealistic 3D exterior visualization of a contemporary residence at dusk\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"><figcaption class=\"media-caption\">Photorealistic exterior visualization · Studio study</figcaption></figure>\n        <div class=\"about-story\" data-anim=\"\">\n          <p class=\"about-label\">Why it matters</p>\n          <h3>Decisions made on screen cost nothing to change.</h3>\n          <p>Most interior disputes come from a gap between what a client imagined and what was drawn. Visualisation closes that gap. You see the finished ceiling, the veneer direction, the lighting temperature and the furniture layout while everything is still editable.</p>\n          <p>Because our render team sits beside our design and site teams, what you approve is what we build — no reinterpretation between image and installation.</p>\n          <div class=\"about-stats\" aria-label=\"Studio facts\">\n            <div class=\"about-stat\"><strong>2018</strong><span>Studio established</span></div>\n            <div class=\"about-stat\"><strong>2 rounds</strong><span>Revisions included</span></div>\n            <div class=\"about-stat\"><strong>4K+</strong><span>Delivery resolution</span></div>\n          </div>\n        </div>\n      </div>\n    </div></section>"
 },
 {
  "id": "dc93371fbb",
  "type": "raw",
  "html": "\n\n    <section class=\"section scope-section\" aria-labelledby=\"scope-title\"><div class=\"wrap\">\n      <header class=\"scope-head\" data-anim=\"\"><p class=\"eyebrow kicker-line\">Choose the right scope</p><h2 id=\"scope-title\">3D Studio vs Interior Design</h2><p class=\"lead muted\">Visualization shows the idea. Interior design creates it.</p></header>\n      <div class=\"comparison-grid\" data-anim=\"\">\n        <article class=\"comparison-card studio-choice\"><span class=\"comparison-number\">01</span><div class=\"comparison-image\"><img src=\"/assets/img/img-dce06249b137.webp\" alt=\"Photorealistic 3D exterior render showing a proposed residence\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"></div><div class=\"comparison-content\"><h3>3D Studio</h3><p>Renders, animation and virtual tours for an existing design.</p></div></article>\n        <div class=\"comparison-vs\" aria-hidden=\"true\">VS</div>\n        <article class=\"comparison-card design-choice\"><span class=\"comparison-number\">02</span><div class=\"comparison-image\"><img src=\"/assets/img/img-c349a92a4ae0.webp\" alt=\"Completed residential interior showing materials, furniture and lighting\" width=\"2240\" height=\"1120\" loading=\"lazy\" decoding=\"async\"></div><div class=\"comparison-content\"><h3>Interior Design</h3><p>Space planning, materials and detailing, with 3D included.</p></div></article>\n      </div>\n      <div class=\"scope-links\" data-anim=\"\"><a class=\"btn\" href=\"/office-interior-design/\" data-page-route=\"officeInterior\">Office design</a><a class=\"btn scope-btn-outline\" href=\"/interior-design/\">Residential design</a></div>\n    </div></section>"
 },
 {
  "id": "e190afd164",
  "type": "raw",
  "html": "\n\n    <section class=\"section cream\" id=\"audiences\"><div class=\"wrap\"><header class=\"section-head center\" data-anim=\"\"><p class=\"eyebrow\">External briefs welcome</p><h2>Who Uses Woodex 3D Studio</h2><p class=\"lead muted\">For teams and clients who need a design  clearly before it is built.</p></header>\n      <div class=\"audience-grid\" data-anim=\"\">\n        <article class=\"audience-card\"><div class=\"icon-line\"><svg fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 48 48\"><path d=\"M8 39h32M13 39V17l11-8 11 8v22M20 39V27h8v12M10 17h28\"></path></svg></div><h3>Architects</h3><p>Clear visuals for design reviews, approvals and presentations.</p></article>\n        <article class=\"audience-card\"><div class=\"icon-line\"><svg fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 48 48\"><path d=\"M9 35l10-3 17-17-7-7-17 17-3 10Zm10-3-7-7M27 10l7 7M28 35h11\"></path></svg></div><h3>Interior designers</h3><p>Detailed renders and animation without maintaining a studio team.</p></article>\n        <article class=\"audience-card\"><div class=\"icon-line\"><svg fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 48 48\"><path d=\"M8 40h32M12 40V13h15v27M27 22h9v18M17 19h5M17 25h5M17 31h5M31 28h2M31 33h2\"></path></svg></div><h3>Developers</h3><p>Sales imagery, virtual tours and flyovers before the build begins.</p></article>\n        <article class=\"audience-card\"><div class=\"icon-line\"><svg fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 48 48\"><path d=\"M6 24 24 9l18 15M11 21v19h26V21M19 40V28h10v12\"></path></svg></div><h3>Homeowners</h3><p>See the space and settle finishes before building.</p></article>\n        <article class=\"audience-card\"><div class=\"icon-line\"><svg fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 48 48\"><path d=\"M8 17h32l-3 9H11l-3-9Zm4 9v14h24V26M17 40V30h14v10M12 17l3-8h18l3 8\"></path></svg></div><h3>Brands and retailers</h3><p>Consistent store visuals for rollouts and investment decks.</p></article>\n      </div>\n    </div></section>"
 },
 {
  "id": "8521a9b78e",
  "type": "raw",
  "html": "\n\n    <section class=\"section\" id=\"services\"><div class=\"wrap\"><header class=\"section-head center\" data-anim=\"\"><p class=\"eyebrow\">One studio, six capabilities</p><h2>Our 3D Visualization Services</h2><p class=\"lead muted\">Choose one service or combine them into a complete presentation.</p></header>\n      <div class=\"service-grid\">\n        <article class=\"service-card\" data-anim=\"\"><div class=\"icon-line\"><svg fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 48 48\"><path d=\"M7 12h34v24H7zM12 31l8-9 6 6 4-5 6 8M32 18h.01\"></path></svg></div><div><h3>Photorealistic 3D Renders</h3><p>Interior and exterior stills for approvals and marketing.</p><a class=\"quote-link\" href=\"#brief\">Get quote</a></div></article>\n        <article class=\"service-card\" data-anim=\"\"><div class=\"icon-line\"><svg fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 48 48\"><rect x=\"6\" y=\"10\" width=\"36\" height=\"28\" rx=\"2\"></rect><path d=\"m20 17 11 7-11 7V17Z\"></path></svg></div><div><h3>3D Animation</h3><p>Walkthroughs and flyovers that reveal the full spatial experience.</p><a class=\"quote-link\" href=\"#brief\">Get quote</a></div></article>\n        <article class=\"service-card\" data-anim=\"\"><div class=\"icon-line\"><svg fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 48 48\"><circle cx=\"24\" cy=\"24\" r=\"16\"></circle><path d=\"M8 24h32M24 8c5 5 7 10 7 16s-2 11-7 16c-5-5-7-10-7-16s2-11 7-16Z\"></path></svg></div><div><h3>360° Virtual Tours</h3><p>Interactive tours for remote viewing and early sales.</p><a class=\"quote-link\" href=\"#brief\">Get quote</a></div></article>\n        <article class=\"service-card\" data-anim=\"\"><div class=\"icon-line\"><svg fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 48 48\"><circle cx=\"12\" cy=\"12\" r=\"5\"></circle><path d=\"M12 2v4M12 18v4M2 12h4M18 12h4M26 39h16L34 23 26 39ZM6 42l20-3\"></path></svg></div><div><h3>Sciography Studies</h3><p>Sun path and shadow analysis for planning and daylight review.</p><a class=\"quote-link\" href=\"#brief\">Get quote</a></div></article>\n        <article class=\"service-card\" data-anim=\"\"><div class=\"icon-line\"><svg fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 48 48\"><path d=\"M10 11h28v21H22l-8 7v-7h-4V11ZM16 18h16M16 24h10\"></path></svg></div><div><h3>Visualization Consultancy</h3><p>Sharper briefs, workflows and presentation strategy.</p><a class=\"quote-link\" href=\"#brief\">Get quote</a></div></article>\n        <article class=\"service-card\" data-anim=\"\"><div class=\"icon-line\"><svg fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 48 48\"><path d=\"M35 15a15 15 0 1 0 3 16M35 15V7M35 15h8M18 20h12v12H18z\"></path></svg></div><div><h3>Revisions &amp; Variants</h3><p>Material, colour and finish options on an approved scene.</p><a class=\"quote-link\" href=\"#brief\">Get quote</a></div></article>\n      </div>\n      <div class=\"service-note\" data-anim=\"\"><p>Need a complete presentation? Combine stills, motion and a virtual tour.</p><a class=\"btn\" href=\"#brief\">Start a brief</a></div>\n    </div></section>"
 },
 {
  "id": "6d2979b3c2",
  "type": "raw",
  "html": "\n\n    <section class=\"section cream\" id=\"deliver\"><div class=\"wrap\"><header class=\"section-head\" data-anim=\"\"><p class=\"eyebrow\">Agreed before production</p><h2>What the Studio Delivers</h2><p class=\"lead muted\">Quality, timing and revisions are agreed before work begins.</p></header>\n      <div class=\"deliver-grid\" data-anim=\"\"><div class=\"deliver-col\"><h3>Output Quality</h3><ul class=\"checklist\"><li>Photorealistic interior and exterior renders</li><li>Compositions ready for marketing</li><li>Multiple views and framing options</li><li>Accurate materials and finishes</li><li>Natural and artificial lighting</li><li>4K and print quality files</li></ul></div><div class=\"deliver-col\"><h3>Service and Turnaround</h3><ul class=\"checklist\"><li>Dates confirmed before production</li><li>Two revision rounds included</li><li>Basic renders in 2 to 5 days</li><li>Animation timelines set per brief</li><li>PNG, JPG, MOV and MP4 delivery</li><li>Clear, itemized quote</li></ul></div></div>\n      <a class=\"btn btn-ink\" href=\"#brief\">Start a brief</a>\n    </div></section>"
 },
 {
  "id": "a0525555d7",
  "type": "raw",
  "html": "\n\n    <section class=\"section\" id=\"process\"><div class=\"wrap\"><header class=\"section-head center\" data-anim=\"\"><p class=\"eyebrow\">From drawing to image</p><h2>How It Works · Five Steps</h2><p class=\"lead muted\">A clear process with fixed milestones and feedback rounds.</p></header>\n      <div class=\"timeline\" data-anim=\"\">\n        <article class=\"step\"><div class=\"step-num\">STEP 01</div><h3>Brief</h3><p>Share drawings, references, views and deadline. We confirm scope and quote.</p></article>\n        <article class=\"step\"><div class=\"step-num\">STEP 02</div><h3>Scene Setup</h3><p>We model the space, furniture, fixtures and details to specification.</p></article>\n        <article class=\"step\"><div class=\"step-num\">STEP 03</div><h3>Light and Materials</h3><p>Accurate finishes and lighting bring the design intent into focus.</p></article>\n        <article class=\"step\"><div class=\"step-num\">STEP 04</div><h3>Render</h3><p>We produce the agreed views at presentation quality.</p></article>\n        <article class=\"step\"><div class=\"step-num\">STEP 05</div><h3>Refine</h3><p>Two revision rounds refine materials, lighting and composition.</p></article>\n      </div>\n      <div class=\"turnaround\" data-anim=\"\"><strong>Basic renders in 2 to 5 days</strong><p>Dates and revisions are confirmed before production.</p><a class=\"btn btn-ink\" href=\"#brief\">Start a brief</a></div>\n    </div></section>"
 },
 {
  "id": "bb0a80d95f",
  "type": "raw",
  "html": "\n\n    <section class=\"section cream\" id=\"work\"><div class=\"wrap\"><header class=\"section-head center\" data-anim=\"\"><p class=\"eyebrow\">Visualization studies</p><h2>Featured 3D Work</h2><p class=\"lead muted\">Interior, workplace and retail studies from the studio.</p></header>\n      <div class=\"gallery\" data-anim=\"\">\n        <article class=\"gallery-card\"><img src=\"/assets/img/img-c349a92a4ae0.webp\" alt=\"Residential living room visualization study with warm wood, stone and evening light\" width=\"2240\" height=\"1120\" loading=\"lazy\" decoding=\"async\"><div class=\"gallery-copy\"><div class=\"tags\">Interior · Photorealistic render</div><h3>Residential Living Study</h3><p>An interior study composed for approval and presentation.</p></div></article>\n        <article class=\"gallery-card alt\"><img src=\"/assets/img/img-1d6ad6c77d0f.webp\" alt=\"3D office walkthrough still showing a contemporary corporate interior in Lahore\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"><div class=\"gallery-copy\"><div class=\"tags\">Office · Walkthrough frame</div><h3>Corporate Walkthrough Study</h3><p>An office sequence prepared for client approvals.</p></div></article>\n        <article class=\"gallery-card\"><img src=\"/assets/img/img-f655d51401e8.webp\" alt=\"360-degree virtual tour still of a retail materials showroom\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"><div class=\"gallery-copy\"><div class=\"tags\">Retail · 360° virtual tour</div><h3>Showroom Virtual Tour Study</h3><p>An interactive retail scene structured for remote presentation.</p></div></article>\n      </div>\n      <div class=\"gallery-foot\" data-anim=\"\"><p>Share your drawings to scope a project.</p><a class=\"btn btn-ink\" href=\"/3d-visualization/\">View work</a></div>\n    </div></section>"
 },
 {
  "id": "74118d5a17",
  "type": "raw",
  "html": "\n\n    <section class=\"section\" id=\"marketing\"><div class=\"wrap\"><header class=\"section-head\" data-anim=\"\"><p class=\"eyebrow\">Built to communicate</p><h2>3D for Marketing and Early Sales</h2><p class=\"lead muted\">Presentation imagery that is ready before construction begins.</p></header>\n      <div class=\"marketing-grid\" data-anim=\"\"><article class=\"marketing-col\"><span class=\"number\">01</span><h3>For Developers</h3><p>Sell the vision early with renders and virtual tours.</p></article><article class=\"marketing-col\"><span class=\"number\">02</span><h3>For Designers</h3><p>Turn drawings into confident client presentations.</p></article><article class=\"marketing-col\"><span class=\"number\">03</span><h3>For Brands</h3><p>Show a consistent store concept across every location.</p></article></div>\n      <a class=\"btn btn-ink\" href=\"#brief\">Request quote</a>\n    </div></section>"
 },
 {
  "id": "4435940a3f",
  "type": "raw",
  "html": "\n\n    <section class=\"section cream\" id=\"pricing\"><div class=\"wrap split\"><header data-anim=\"\" class=\"\"><p class=\"eyebrow\">Indicative 2026 rates</p><h2>What Does 3D Visualization Cost?</h2><p class=\"lead muted\">A clear starting point for planning your brief.</p><div class=\"price-note\"><svg fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 32 32\"><circle cx=\"16\" cy=\"16\" r=\"13\"></circle><path d=\"M16 14v8M16 9h.01\"></path></svg><p>Final pricing reflects scene complexity, lighting and animation length.</p></div><div style=\"margin-top:26px\"><a class=\"btn btn-ink\" href=\"#brief\">Get quote</a></div></header>\n      <div class=\"price-list\" data-anim=\"\"><div class=\"price-row\"><span>Single Interior Render</span><strong>PKR 20K to 50K</strong></div><div class=\"price-row\"><span>Exterior Render</span><strong>PKR 30K to 80K</strong></div><div class=\"price-row\"><span>3D Animation (30 sec)</span><strong>PKR 100K to 300K</strong></div><div class=\"price-row\"><span>Virtual Tour</span><strong>PKR 50K to 200K</strong></div><div class=\"price-row\"><span>Full Project Visualization (10+ renders)</span><strong>PKR 200K to 500K</strong></div></div>\n    </div></section>"
 },
 {
  "id": "0da7bfd54e",
  "type": "raw",
  "html": "\n\n    <section class=\"section\" id=\"why\"><div class=\"wrap\"><header class=\"section-head center\" data-anim=\"\"><p class=\"eyebrow\">Production discipline, design understanding</p><h2>Why Choose Woodex 3D Studio?</h2></header>\n      <div class=\"why-grid\" data-anim=\"\">\n        <article class=\"why-card\"><div class=\"roman\">I</div><h3>In House Expertise</h3><p>3ds Max and AutoCAD production stays with our studio team.</p></article>\n        <article class=\"why-card\"><div class=\"roman\">II</div><h3>Confirmed Turnaround</h3><p>Basic renders in 2 to 5 days, with dates agreed upfront.</p></article>\n        <article class=\"why-card\"><div class=\"roman\">III</div><h3>Ready for Marketing</h3><p>Every view is composed for approval, presentation and sale.</p></article>\n        <article class=\"why-card\"><div class=\"roman\">IV</div><h3>Independent Service</h3><p>Commission the studio even when Woodex is not building.</p></article>\n        <article class=\"why-card\"><div class=\"roman\">V</div><h3>Built on Experience</h3><p>Ten years of design and visualization across 200+ projects.</p></article>\n        <article class=\"why-card\"><div class=\"roman\">VI</div><h3>Clear Revisions</h3><p>Two rounds, fixed dates and itemized quotes.</p></article>\n      </div>\n    </div></section>"
 },
 {
  "id": "3e2bd9edb7",
  "type": "raw",
  "html": "\n\n    <section class=\"section cream\" id=\"related\"><div class=\"wrap\"><header class=\"section-head\" data-anim=\"\"><p class=\"eyebrow light\">Continue with Woodex</p><h2>Related Woodex Services</h2></header><div class=\"related-slider-shell\" data-anim=\"\">\n      <div class=\"related-viewport\" id=\"related-viewport\"><div class=\"related-track\" id=\"related-track\" style=\"transform: translate3d(0px,0,0);\">\n        <a class=\"related-card\" href=\"/office-interior-design/\" data-page-route=\"officeInterior\"><div class=\"related-image\"><img src=\"/assets/img/img-1d6ad6c77d0f.webp\" alt=\"Contemporary office interior with meeting rooms and natural light\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"></div><div class=\"related-content\"><h3>Office Interior Design</h3><p>Planning, concept, visualization and working drawings.</p><span class=\"arrow\" aria-hidden=\"true\">↗</span></div></a>\n        <a class=\"related-card\" href=\"/interior-design/\"><div class=\"related-image\"><img src=\"/assets/img/img-c349a92a4ae0.webp\" alt=\"Warm contemporary residential living room interior\" width=\"2240\" height=\"1120\" loading=\"lazy\" decoding=\"async\"></div><div class=\"related-content\"><h3>Residential Interior Design</h3><p>Whole-home design with 3D included.</p><span class=\"arrow\" aria-hidden=\"true\">↗</span></div></a>\n        <a class=\"related-card\" href=\"/turnkey-design-build/\"><div class=\"related-image\"><img src=\"/assets/img/img-dce06249b137.webp\" alt=\"Contemporary completed residence representing turnkey design and build\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"></div><div class=\"related-content\"><h3>Turnkey Design &amp; Build</h3><p>Design, build and furnish under one contract.</p><span class=\"arrow\" aria-hidden=\"true\">↗</span></div></a>\n        <a class=\"related-card\" href=\"https://woodexfurniture.pk\" target=\"_blank\" rel=\"noopener\"><div class=\"related-image\"><img src=\"/assets/img/img-f655d51401e8.webp\" alt=\"Woodex showroom displaying custom doors and interior joinery\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"></div><div class=\"related-content\"><h3>Woodex Furniture™</h3><p>Custom kitchens, wardrobes and millwork.</p><span class=\"arrow\" aria-hidden=\"true\">↗</span></div></a>\n        <a class=\"related-card\" href=\"/office-fit-out/\" data-page-route=\"officeFitout\"><div class=\"related-image\"><img src=\"/assets/img/img-1d6ad6c77d0f.webp\" alt=\"Finished contemporary office interior by Woodex\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"></div><div class=\"related-content\"><h3>Office Fit-Out</h3><p>From empty shell to a working office.</p><span class=\"arrow\" aria-hidden=\"true\">↗</span></div></a>\n      </div></div>\n      <div class=\"related-controls\" aria-label=\"Related services carousel controls\"><span class=\"slider-status\" id=\"related-status\" aria-live=\"polite\">01 / 05</span><button class=\"slider-btn\" id=\"related-prev\" type=\"button\" aria-label=\"Previous service\" disabled=\"\">←</button><button class=\"slider-btn\" id=\"related-next\" type=\"button\" aria-label=\"Next service\">→</button></div>\n    </div></div></section>"
 },
 {
  "id": "8e2fe4e8d7",
  "type": "raw",
  "html": "\n    <section class=\"section navy\" id=\"brief\"><div class=\"wrap contact-grid\"><div class=\"contact-copy\" data-anim=\"\"><p class=\"eyebrow light\">Send the essentials</p><h2>Start a 3D Visualization Brief</h2><p class=\"lead\">Share the project, views and deadline. We will confirm scope and quote within one business day.</p><div class=\"contact-list\"><h3>Woodex 3D Studio</h3><p>M-71, Zainab Tower, Model Town Link Road, Lahore</p><p><a href=\"tel:+923224000768\">+92 322 4000768</a> &nbsp;|&nbsp; <a href=\"tel:+923214686884\">+92 321 4686884</a></p><p><a href=\"mailto:info@woodex.com.pk\">info@woodex.com.pk</a></p><p>Monday to Saturday, 9:30 AM to 6:30 PM</p></div></div>\n      <form class=\"form-card\" id=\"brief-form\" data-anim=\"\"><h3>Send your brief</h3><div class=\"field-grid\">\n        <div class=\"field\"><label for=\"name\">Full Name *</label><input id=\"name\" name=\"name\" required=\"\" autocomplete=\"name\"></div><div class=\"field\"><label for=\"phone\">Phone Number *</label><input id=\"phone\" name=\"phone\" required=\"\" type=\"tel\" autocomplete=\"tel\"></div>\n        <div class=\"field full\"><label for=\"email\">Email Address *</label><input id=\"email\" name=\"email\" required=\"\" type=\"email\" autocomplete=\"email\"></div>\n        <div class=\"field\"><label for=\"professional\">Professional Type *</label><select id=\"professional\" name=\"professional\" required=\"\"><option value=\"\">Select one</option><option>Architect</option><option>Interior designer</option><option>Developer</option><option>Homeowner / investor</option><option>Brand / retailer</option><option>Other</option></select></div>\n        <div class=\"field\"><label for=\"service\">Service Required *</label><select id=\"service\" name=\"service\" required=\"\"><option value=\"\">Select service</option><option>Photorealistic renders</option><option>3D animation / walkthrough</option><option>360° virtual tour</option><option>Sciography (shadow study)</option><option>Visualization consultancy</option><option>Full presentation package</option></select></div>\n        <div class=\"field\"><label for=\"outputs\">Number of Views / Outputs *</label><select id=\"outputs\" name=\"outputs\" required=\"\"><option value=\"\">Select range</option><option>1 to 5 renders</option><option>6 to 10 renders</option><option>11+ renders / full project</option><option>Animation (duration to confirm)</option><option>Not sure, need guidance</option></select></div>\n        <div class=\"field\"><label for=\"timeline\">Timeline *</label><select id=\"timeline\" name=\"timeline\" required=\"\"><option value=\"\">Select timeline</option><option>As soon as possible</option><option>Within 1 week</option><option>Within 2 to 4 weeks</option><option>Flexible</option></select></div>\n        <div class=\"field full\"><label for=\"details\">Message / Project Details *</label><textarea id=\"details\" name=\"details\" required=\"\" placeholder=\"Project type, available drawings, preferred views and any deadline details\"></textarea></div>\n      </div><div class=\"form-actions\"><button class=\"btn btn-ink\" type=\"submit\">Send brief</button><p class=\"form-note\">Response within one business day.</p></div><p class=\"form-status\" id=\"form-status\" role=\"status\">Your email app will open with the brief ready to review and send.</p></form>\n    </div></section>"
 },
 {
  "id": "d02f63d8f0",
  "type": "raw",
  "html": "\n\n    <section class=\"section cream\" id=\"faq\"><div class=\"wrap\"><header class=\"section-head center\" data-anim=\"\"><p class=\"eyebrow\">Practical answers</p><h2>3D Visualization: Frequently Asked Questions</h2></header><div class=\"faq-wrap\" data-anim=\"\">\n      <div class=\"faq-item\"><button class=\"faq-q\" aria-expanded=\"true\"><span>How fast can I get a render?</span><span class=\"plus\">+</span></button><div class=\"faq-a\"><div><p>Basic interior and exterior renders are typically delivered in 2 to 5 days. We confirm the delivery date before work begins.</p></div></div></div>\n      <div class=\"faq-item\"><button class=\"faq-q\" aria-expanded=\"false\"><span>What files do I receive?</span><span class=\"plus\">+</span></button><div class=\"faq-a\"><div><p>Renders arrive as high resolution PNG and JPG files, with 4K and print quality available. Animations arrive as MOV and MP4 files.</p></div></div></div>\n      <div class=\"faq-item\"><button class=\"faq-q\" aria-expanded=\"false\"><span>How many revisions are included?</span><span class=\"plus\">+</span></button><div class=\"faq-a\"><div><p>Every brief includes two revision rounds. Extra rounds and finish options can be added if needed.</p></div></div></div>\n      <div class=\"faq-item\"><button class=\"faq-q\" aria-expanded=\"false\"><span>Can I commission renders without using Woodex to build?</span><span class=\"plus\">+</span></button><div class=\"faq-a\"><div><p>Yes. Woodex 3D Studio is a standalone service. Architects, interior designers and developers commission visualization from us even when another practice is executing the build.</p></div></div></div>\n      <div class=\"faq-item\"><button class=\"faq-q\" aria-expanded=\"false\"><span>Do you do exterior renders and animations?</span><span class=\"plus\">+</span></button><div class=\"faq-a\"><div><p>Yes. Photorealistic exterior renders and walkthrough/flyover animations are part of the studio's core scope.</p></div></div></div>\n      <div class=\"faq-item\"><button class=\"faq-q\" aria-expanded=\"false\"><span>What is a sciography study?</span><span class=\"plus\">+</span></button><div class=\"faq-a\"><div><p>A sciography study shows the sun path and shadow patterns across a site and building. It helps with planning, daylight analysis and environmental review.</p></div></div></div>\n      <div class=\"faq-item\"><button class=\"faq-q\" aria-expanded=\"false\"><span>Do you produce 360° virtual tours?</span><span class=\"plus\">+</span></button><div class=\"faq-a\"><div><p>Yes. We produce interactive 360° tours for early sales and marketing, so viewers can explore the space online from any device.</p></div></div></div>\n      <div class=\"faq-item\"><button class=\"faq-q\" aria-expanded=\"false\"><span>What information do you need to start?</span><span class=\"plus\">+</span></button><div class=\"faq-a\"><div><p>Drawings or concept references, the camera angles you need and your deadline. From that, we confirm scope, turnaround and quote within one business day.</p></div></div></div>\n    </div></div></section>\n\n  \n"
 }
]
