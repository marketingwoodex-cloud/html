  "id": "fc7aabaea0",
  "type": "hero",
  "html": "\n\n    <section class=\"id-hero\" aria-labelledby=\"interior-title\"><div class=\"wrap id-hero-grid\">\n      <div class=\"id-hero-copy id-reveal\"><nav class=\"crumbs\" aria-label=\"Breadcrumb\"><a href=\"/\">Home</a><span>→</span><span>Interior Design</span></nav><p class=\"id-label\">Interior design · Lahore</p><h1 id=\"interior-title\">Every room, designed around you.</h1><p class=\"lead\">Woodex plans the layout, materials, furniture and light as one complete interior. Every design includes 3D visualization before work begins.</p><div class=\"actions\"><a class=\"btn\" href=\"#interior-contact\">Get a free consultation</a><a class=\"btn btn-light\" href=\"https://wa.me/923224000768\">WhatsApp</a></div></div>\n      <figure class=\"id-image id-hero-media id-reveal\"><img src=\"/assets/img/img-c349a92a4ae0.webp\" alt=\"Contemporary residential interior visualization with warm timber, soft lighting and tailored furniture\" width=\"2240\" height=\"1120\" loading=\"lazy\" decoding=\"async\"><figcaption class=\"id-hero-note\"><strong>See the space before it is built</strong><span>3D visualization included</span></figcaption></figure>\n    </div></section>",
