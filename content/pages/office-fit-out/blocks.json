 {
  "id": "d5b071717c",
  "type": "raw",
  "html": "\n\n    <section class=\"fitout-section is-inview\" id=\"fitout-business\"><div class=\"wrap\">\n      <header class=\"fitout-section-head\" data-anim=\"\"><p class=\"eyebrow kicker-line\">Designed around the operation</p><h2>Office Fit-Out for Different Business Types</h2><p class=\"lead muted\">The space, services and finish change with the way each business works.</p></header>\n      <div class=\"fitout-business-grid\">\n        <article class=\"fitout-business\" data-anim=\"\"><figure class=\"fitout-business-media\"><img src=\"/assets/img/img-1d6ad6c77d0f.webp\" alt=\"Contemporary office interior with workstations and meeting areas\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"></figure><div class=\"fitout-business-copy\"><small>Corporate</small><h3>Corporate Offices</h3><p>Executive cabins, meeting rooms, reception, workstations and a polished client experience.</p></div></article>\n        <article class=\"fitout-business\" data-anim=\"\"><figure class=\"fitout-business-media\"><img src=\"/assets/img/img-1d6ad6c77d0f.webp\" alt=\"Open office interior with integrated lighting and collaborative work areas\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"></figure><div class=\"fitout-business-copy\"><small>Technology</small><h3>Software Houses</h3><p>Efficient open plans, breakout space, meeting rooms, acoustics and robust power.</p></div></article>\n        <article class=\"fitout-business\" data-anim=\"\"><figure class=\"fitout-business-media\"><img src=\"/assets/img/img-c349a92a4ae0.webp\" alt=\"Flexible contemporary interior with multiple work and meeting zones\" width=\"2240\" height=\"1120\" loading=\"lazy\" decoding=\"async\"></figure><div class=\"fitout-business-copy\"><small>Flexible workspace</small><h3>Co-Working</h3><p>Durable shared areas, hot desks, private offices and rooms in several sizes.</p></div></article>\n        <article class=\"fitout-business\" data-anim=\"\"><figure class=\"fitout-business-media\"><img src=\"/assets/img/img-f655d51401e8.webp\" alt=\"Compact workspace with custom furniture and storage\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"></figure><div class=\"fitout-business-copy\"><small>Growing teams</small><h3>Startups</h3><p>A professional office with a sensible scope and room to scale.</p></div></article>\n        <article class=\"fitout-business\" data-anim=\"\"><figure class=\"fitout-business-media\"><img src=\"/assets/img/img-c349a92a4ae0.webp\" alt=\"Calm interior reference with durable finishes and clear circulation\" width=\"2240\" height=\"1120\" loading=\"lazy\" decoding=\"async\"></figure><div class=\"fitout-business-copy\"><small>Healthcare</small><h3>Clinics</h3><p>Private consultation rooms, waiting, reception and finishes chosen for easy care.</p></div></article>\n        <article class=\"fitout-business\" data-anim=\"\"><figure class=\"fitout-business-media\"><img src=\"/assets/img/img-f655d51401e8.webp\" alt=\"Retail showroom interior with customer display areas\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"></figure><div class=\"fitout-business-copy\"><small>Mixed use</small><h3>Showroom Offices</h3><p>A customer-facing front with a focused working space behind it.</p></div></article>\n        <article class=\"fitout-business\" data-anim=\"\"><figure class=\"fitout-business-media\"><img src=\"/assets/img/img-dce06249b137.webp\" alt=\"Large commercial workplace reference for a high-density operation\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"></figure><div class=\"fitout-business-copy\"><small>High density</small><h3>Call Centres and BPOs</h3><p>Dense seating, reliable cabling, controlled acoustics and practical lighting.</p></div></article>\n      </div>\n      <div class=\"fitout-related\" data-anim=\"\"><a href=\"/office-interior-design/\"><span>Sector</span><strong>Corporate Offices</strong></a><a href=\"/office-fit-out/\"><span>Sector</span><strong>Software Houses</strong></a><a href=\"/healthcare-fit-out/\"><span>Sector</span><strong>Healthcare Fit-Out</strong></a></div>\n    </div></section>"
 },
 {
  "id": "39f55222da",
  "type": "raw",
  "html": "\n\n    <div class=\"fitout-marquee is-inview is-running\" aria-label=\"Office fit-out scope\"><div class=\"fitout-marquee-track\"><div class=\"fitout-marquee-group\"><span>Partitions</span><span>Ceilings</span><span>Flooring</span><span>Electrical</span><span>Lighting</span><span>Joinery</span><span>Furniture</span><span>Handover</span></div><div class=\"fitout-marquee-group\" aria-hidden=\"true\"><span>Partitions</span><span>Ceilings</span><span>Flooring</span><span>Electrical</span><span>Lighting</span><span>Joinery</span><span>Furniture</span><span>Handover</span></div></div></div>"
 },
 {
  "id": "bfa62bf601",
  "type": "raw",
  "html": "\n\n    <section class=\"fitout-section navy-block is-inview\" id=\"fitout-cost\"><div class=\"wrap\">\n      <header class=\"fitout-section-head\" data-anim=\"\"><p class=\"eyebrow\">Indicative Lahore ranges</p><h2>Office Fit-Out Cost, What Influences Price</h2><p class=\"lead\">Useful planning ranges. Your survey and BOQ set the real project price.</p></header>\n      <div class=\"fitout-price-grid\" data-anim=\"\"><article class=\"fitout-price-card\"><small>500 to 1,000 sq. ft.</small><h3>Small office</h3><strong>PKR 800K to 2.5M</strong></article><article class=\"fitout-price-card\"><small>1,000 to 2,500 sq. ft.</small><h3>Medium office</h3><strong>PKR 2M to 6M</strong></article><article class=\"fitout-price-card\"><small>2,500 to 5,000+ sq. ft.</small><h3>Large office</h3><strong>PKR 5M to 15M+</strong></article></div>\n      <div class=\"fitout-drivers\" data-anim=\"\"><div class=\"fitout-driver\"><strong>Size</strong><span>Area sets material and labour volume.</span></div><div class=\"fitout-driver\"><strong>Site condition</strong><span>Bare shells need more infrastructure.</span></div><div class=\"fitout-driver\"><strong>Partitions</strong><span>Drywall, framed and frameless glass differ.</span></div><div class=\"fitout-driver\"><strong>Ceiling</strong><span>Grid, gypsum and acoustic systems vary.</span></div><div class=\"fitout-driver\"><strong>Flooring</strong><span>Tile, vinyl, wood and epoxy affect cost.</span></div><div class=\"fitout-driver\"><strong>Electrical</strong><span>Load, point count and controls matter.</span></div><div class=\"fitout-driver\"><strong>Joinery</strong><span>Custom built-ins are priced to detail.</span></div><div class=\"fitout-driver\"><strong>Plumbing and AC</strong><span>New service routes add significant work.</span></div><div class=\"fitout-driver\"><strong>Washrooms</strong><span>Each room adds fixtures and finishing.</span></div><div class=\"fitout-driver\"><strong>Branding</strong><span>Custom signs and walls add fabrication.</span></div><div class=\"fitout-driver\"><strong>Access</strong><span>Lifts, timing and approvals affect delivery.</span></div></div>\n      <div class=\"fitout-cost-note\" data-anim=\"\"><p>Ranges cover a complete fit-out. Removing furniture or selected trades lowers the total. A site survey gives you the reliable figure.</p><a class=\"btn\" href=\"#fitout-quote\">Get a real price</a></div>\n    </div></section>"
 },
 {
  "id": "0a7c92355c",
  "type": "raw",
  "html": "\n\n    <section class=\"fitout-section is-inview\" id=\"fitout-compare\"><div class=\"wrap\">\n      <header class=\"fitout-section-head\" data-anim=\"\"><p class=\"eyebrow kicker-line\">Choose the right service</p><h2>Office Fit-Out vs Interior Design vs Turnkey</h2><p class=\"lead muted\">Three clear scopes, depending on what is already decided.</p></header>\n      <div class=\"fitout-compare-grid\" data-anim=\"\">\n        <article class=\"fitout-compare-card\"><div class=\"fitout-placeholder\"><img src=\"/assets/img/img-c349a92a4ae0.webp\" alt=\"Interior design concept with coordinated furniture and finishes\" width=\"2240\" height=\"1120\" loading=\"lazy\" decoding=\"async\"><span>Design image placeholder</span></div><h3>Interior Design</h3><p>Layout, 3D views, materials and drawings. Construction is separate.</p><a class=\"text-link\" href=\"/office-interior-design/\" data-page-route=\"officeInterior\">Explore design</a></article>\n        <article class=\"fitout-compare-card featured\"><div class=\"fitout-placeholder\"><img src=\"/assets/img/img-1d6ad6c77d0f.webp\" alt=\"Completed office fit-out with workstations and lighting\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"><span>Fit-out image placeholder</span></div><h3>Office Fit-Out</h3><p>The construction stage. Best when your design or brief is already clear.</p><a class=\"text-link\" href=\"#fitout-quote\">Price the build</a></article>\n        <article class=\"fitout-compare-card\"><div class=\"fitout-placeholder\"><img src=\"/assets/img/img-dce06249b137.webp\" alt=\"Completed turnkey commercial building project\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"><span>Turnkey image placeholder</span></div><h3>Turnkey Design &amp; Build</h3><p>Design and construction together, managed by one team from brief to handover.</p><a class=\"text-link\" href=\"/turnkey-design-build/\">Explore turnkey</a></article>\n      </div>\n      <div class=\"fitout-compare-guide\" data-anim=\"\"><p><strong>Not sure?</strong> Start with a site survey and we will recommend the right scope.</p><a class=\"btn\" href=\"#fitout-quote\">Book a survey</a></div>\n    </div></section>"
 },
 {
  "id": "e6673db38c",
  "type": "raw",
  "html": "\n\n    <section class=\"fitout-section navy-block is-inview\" id=\"fitout-faq\"><div class=\"wrap fitout-faq-layout\">\n      <header class=\"fitout-section-head\" data-anim=\"\"><p class=\"eyebrow\">Practical answers</p><h2>Office Fit-Out FAQ</h2></header>\n      <div class=\"faq-wrap\" data-anim=\"\">\n        <div class=\"faq-item\"><button class=\"faq-q\" aria-expanded=\"true\"><span>How long does an office fit-out take?</span><span class=\"plus\">+</span></button><div class=\"faq-a\"><div><p>A standard 1,000 to 3,000 sq. ft. office usually takes 3 to 6 weeks after design approval. Scope, materials and building access can change the timeline.</p></div></div></div>\n        <div class=\"faq-item\"><button class=\"faq-q\" aria-expanded=\"false\"><span>Do you work with empty shells or partially fitted spaces?</span><span class=\"plus\">+</span></button><div class=\"faq-a\"><div><p>Both. We can build from an empty shell, complete unfinished work or upgrade an existing office.</p></div></div></div>\n        <div class=\"faq-item\"><button class=\"faq-q\" aria-expanded=\"false\"><span>Do I need the design done first?</span><span class=\"plus\">+</span></button><div class=\"faq-a\"><div><p>No. We can build from your drawings, or provide design and fit-out as one coordinated package.</p></div></div></div>\n        <div class=\"faq-item\"><button class=\"faq-q\" aria-expanded=\"false\"><span>What is included in the BOQ?</span><span class=\"plus\">+</span></button><div class=\"faq-a\"><div><p>Every agreed trade, material, quantity, price and management item is listed before work begins.</p></div></div></div>\n        <div class=\"faq-item\"><button class=\"faq-q\" aria-expanded=\"false\"><span>Can you work while we occupy the office?</span><span class=\"plus\">+</span></button><div class=\"faq-a\"><div><p>Yes. We can phase rooms and plan disruptive work around your business hours.</p></div></div></div>\n        <div class=\"faq-item\"><button class=\"faq-q\" aria-expanded=\"false\"><span>Do you supply furniture?</span><span class=\"plus\">+</span></button><div class=\"faq-a\"><div><p>Yes. We supply and install furniture, or install items you source yourself.</p></div></div></div>\n        <div class=\"faq-item\"><button class=\"faq-q\" aria-expanded=\"false\"><span>What warranty do you provide?</span><span class=\"plus\">+</span></button><div class=\"faq-a\"><div><p>The agreed fit-out construction and installation scope carries a 1-year workmanship warranty.</p></div></div></div>\n        <div class=\"faq-item\"><button class=\"faq-q\" aria-expanded=\"false\"><span>Do you handle building approvals?</span><span class=\"plus\">+</span></button><div class=\"faq-a\"><div><p>We provide technical information and coordinate site requirements. Formal approvals may involve your landlord or building management.</p></div></div></div>\n        <div class=\"faq-item\"><button class=\"faq-q\" aria-expanded=\"false\"><span>Do you work outside Lahore?</span><span class=\"plus\">+</span></button><div class=\"faq-a\"><div><p>Lahore is our main service area. We consider selected projects elsewhere in Punjab based on size and logistics.</p></div></div></div>\n        <div class=\"faq-item\"><button class=\"faq-q\" aria-expanded=\"false\"><span>How are payments scheduled?</span><span class=\"plus\">+</span></button><div class=\"faq-a\"><div><p>Payments are tied to agreed project milestones and written into the contract before site work starts.</p></div></div></div>\n      </div>\n    </div></section>"
 },
 {
  "id": "920b41fb2e",
  "type": "raw",
  "html": "\n\n    <section class=\"fitout-section is-inview\" id=\"fitout-quote\"><div class=\"wrap fitout-quote-grid\">\n      <div class=\"fitout-contact\" data-anim=\"\"><p class=\"eyebrow kicker-line\">Tell us about the space</p><h2>Request an Office Fit-Out Quote</h2><p class=\"lead\">Share the essentials. We will review the scope and arrange the next step.</p><div class=\"fitout-contact-options\"><h3>Talk to Woodex</h3><p><a href=\"tel:+923224000768\">+92 322 4000768</a><br><a href=\"tel:+923214686884\">+92 321 4686884</a></p><p><a href=\"mailto:info@woodex.com.pk\">info@woodex.com.pk</a></p><p>M-71, Zainab Tower<br>Model Town Link Road, Lahore</p><p><strong>Mon–Sat 9:30–6:30</strong></p><p><a href=\"https://wa.me/923224000768\">WhatsApp Woodex →</a></p></div></div>\n      <form class=\"fitout-quote-form\" id=\"fitout-quote-form\" data-anim=\"\"><h3>Request a Fit-Out Quote</h3><div class=\"field-grid\">\n        <div class=\"field\"><label for=\"fit-name\">Full Name *</label><input id=\"fit-name\" name=\"name\" required=\"\" autocomplete=\"name\"></div><div class=\"field\"><label for=\"fit-phone\">Phone Number *</label><input id=\"fit-phone\" name=\"phone\" type=\"tel\" required=\"\" autocomplete=\"tel\"></div>\n        <div class=\"field full\"><label for=\"fit-email\">Email Address *</label><input id=\"fit-email\" name=\"email\" type=\"email\" required=\"\" autocomplete=\"email\"></div>\n        <div class=\"field\"><label for=\"fit-location\">Office Location *</label><input id=\"fit-location\" name=\"location\" required=\"\" placeholder=\"Area, building or city\"></div><div class=\"field\"><label for=\"fit-size\">Approximate Size *</label><input id=\"fit-size\" name=\"size\" required=\"\" placeholder=\"Square feet\"></div>\n        <div class=\"field\"><label for=\"fit-headcount\">Headcount *</label><input id=\"fit-headcount\" name=\"headcount\" required=\"\" type=\"number\" min=\"1\" placeholder=\"Number of people\"></div><div class=\"field\"><label for=\"fit-condition\">Current Condition *</label><select id=\"fit-condition\" name=\"condition\" required=\"\"><option value=\"\">Select one</option><option>Empty shell</option><option>Partially fitted</option><option>Occupied office</option><option>Needs renovation</option><option>Not sure</option></select></div>\n        <div class=\"field full\"><label for=\"fit-rooms\">Rooms Needed *</label><textarea id=\"fit-rooms\" name=\"rooms\" required=\"\" placeholder=\"Cabins, meeting rooms, pantry, washrooms, reception and open seating\"></textarea></div>\n        <div class=\"field\"><label for=\"fit-timeline\">Target Timeline *</label><select id=\"fit-timeline\" name=\"timeline\" required=\"\"><option value=\"\">Select timeline</option><option>Within 4 weeks</option><option>1 to 2 months</option><option>2 to 4 months</option><option>Flexible</option></select></div><div class=\"field\"><label for=\"fit-budget\">Budget Range *</label><select id=\"fit-budget\" name=\"budget\" required=\"\"><option value=\"\">Select range</option><option>Under PKR 1M</option><option>PKR 1M to 3M</option><option>PKR 3M to 6M</option><option>PKR 6M to 10M</option><option>PKR 10M+</option><option>Need guidance</option></select></div>\n        <div class=\"field full\"><label for=\"fit-notes\">Anything Else?</label><textarea id=\"fit-notes\" name=\"notes\" placeholder=\"Access limits, furniture needs, design status or any must-haves\"></textarea></div>\n      </div><div class=\"form-actions\"><button class=\"btn\" type=\"submit\">Prepare email</button><p class=\"form-note\">Your email app will open with the full brief ready to send.</p></div><p class=\"form-status\" id=\"fitout-form-status\" role=\"status\">Your email app is opening with the fit-out brief.</p></form>\n    </div></section>\n  \n"
 }
