 {
  "id": "718bf9be75",
  "type": "hero",
  "html": "\n\n    <section class=\"fitout-hero is-entered\" aria-labelledby=\"fitout-hero-title\">\n      <div class=\"wrap\">\n        <nav class=\"crumbs fitout-crumbs\" aria-label=\"Breadcrumb\"><a href=\"/\">Home</a><span>→</span><a href=\"/fit-out/\">Fit Out</a><span>→</span><span>Office Fit-Out</span></nav>\n        <div class=\"fitout-hero-grid\">\n          <div class=\"fitout-hero-copy\" data-anim=\"\">\n            <p class=\"eyebrow light\">Built around the way your team works</p>\n            <h1 id=\"fitout-hero-title\"><span class=\"fitout-word\"><span class=\"fitout-word-inner\" style=\"transition-delay: 0ms;\">Office</span></span> <span class=\"fitout-word\"><span class=\"fitout-word-inner\" style=\"transition-delay: 70ms;\">Fit-Out</span></span> <span class=\"fitout-word\"><span class=\"fitout-word-inner\" style=\"transition-delay: 140ms;\">in</span></span> <span class=\"fitout-word\"><span class=\"fitout-word-inner\" style=\"transition-delay: 210ms;\">Lahore</span></span></h1>\n            <p class=\"lead\">From empty shell to a finished workplace. One team for partitions, ceilings, flooring, services, joinery and furniture.</p>\n            <div class=\"actions\"><a class=\"btn\" href=\"#fitout-quote\">Get a fit-out quote</a><a class=\"btn btn-light\" href=\"/3d-visualization/\">View office projects</a></div>\n          </div>\n          <figure class=\"fitout-visual\" data-anim=\"\"><img class=\"fitout-hero-image\" src=\"/assets/img/img-1d6ad6c77d0f.webp\" alt=\"Contemporary completed office fit-out with workstations and integrated lighting\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"><div class=\"fitout-visual-mark\"><small>Project image placeholder</small><strong>Completed office fit-out</strong><span>Open workstations · Cabins · Reception</span></div></figure>\n          <div class=\"fitout-hero-trust\" aria-label=\"Fit-out highlights\"><span>200+ Office Projects</span><span>10 Years Experience</span><span>Fixed-Price</span><span>1-Year Warranty</span></div>\n        </div>\n      </div>\n    </section>",
  "fields": {
   "heading": "<span class=\"fitout-word\"><span class=\"fitout-word-inner\" style=\"transition-delay: 0ms;\">Office</span></span> <span class=\"fitout-word\"><span class=\"fitout-word-inner\" style=\"transition-delay: 70ms;\">Fit-Out</span></span> <span class=\"fitout-word\"><span class=\"fitout-word-inner\" style=\"transition-delay: 140ms;\">in</span></span> <span class=\"fitout-word\"><span class=\"fitout-word-inner\" style=\"transition-delay: 210ms;\">Lahore</span></span>",
   "cta_text": "Get a fit-out quote",
   "cta_href": "#fitout-quote",
   "img_src": "/assets/img/img-1d6ad6c77d0f.webp",
   "img_alt": "Contemporary completed office fit-out with workstations and integrated lighting"
  }
 },
 {
  "id": "21dcf6456a",
  "type": "raw",
  "html": "\n\n    <section class=\"fitout-section is-inview\" id=\"fitout-about\"><div class=\"wrap fitout-intro-grid\">\n      <div class=\"fitout-intro-copy\" data-anim=\"\"><p class=\"eyebrow kicker-line\">From shell to working office</p><h2>What Is Office Fit-Out?</h2><p class=\"lead\">It is the work that turns an empty commercial space into an office your team can use.</p><p>A typical shell has concrete surfaces and basic utility points. Fit-out adds the rooms, finishes, services and furniture that make it practical. Woodex coordinates the complete scope under one BOQ, one project manager and one warranty.</p><a class=\"text-link\" href=\"/office-interior-design/\" data-page-route=\"officeInterior\">Need design first? Explore Office Interior Design</a></div>\n      <div class=\"fitout-intro-points\" data-anim=\"\"><div><strong>Plan the space</strong><span>Cabins, meeting rooms, reception, pantry and circulation.</span></div><div><strong>Build the shell</strong><span>Partitions, ceiling, flooring and all finishes.</span></div><div><strong>Connect services</strong><span>Power, lighting, plumbing and air conditioning.</span></div><div><strong>Move in ready</strong><span>Joinery, furniture, testing, snagging and handover.</span></div></div>\n    </div></section>"
 },
 {
  "id": "0eb8af934d",
  "type": "raw",
  "html": "\n\n    <section class=\"fitout-section is-inview\" id=\"fitout-includes\"><div class=\"wrap\">\n      <header class=\"fitout-section-head\" data-anim=\"\"><p class=\"eyebrow kicker-line\">One coordinated scope</p><h2>What Woodex Office Fit-Out Includes</h2><p class=\"lead muted\">Every trade is planned together, priced clearly and supervised by one team.</p></header>\n      <div class=\"fitout-scope-slider\" data-fitout-slider=\"\"><div class=\"fitout-scope-viewport\" id=\"fitout-scope-viewport\"><div class=\"fitout-scope-grid\" id=\"fitout-scope-track\" style=\"transform: translate3d(0px,0,0);\">\n        <article class=\"fitout-scope-card\" data-anim=\"\"><h3>Partitions</h3><p>Drywall, acoustic, framed or frameless glass, plus privacy options.</p></article>\n        <article class=\"fitout-scope-card\" data-anim=\"\"><h3>Ceilings</h3><p>Gypsum, accessible grid or open ceiling, coordinated with lights and AC.</p></article>\n        <article class=\"fitout-scope-card\" data-anim=\"\"><h3>Flooring</h3><p>Vitrified tile, laminate, engineered wood, vinyl, epoxy and anti-slip finishes.</p></article>\n        <article class=\"fitout-scope-card\" data-anim=\"\"><h3>Electrical</h3><p>Load planning, wiring, sockets, distribution boards, earthing and protection.</p></article>\n        <article class=\"fitout-scope-card\" data-anim=\"\"><h3>Lighting</h3><p>LED panels, downlights, cove lighting, emergency lights and area controls.</p></article>\n        <article class=\"fitout-scope-card\" data-anim=\"\"><h3>FM Plumbing</h3><p>Washrooms, pantry supply, drainage and building service connections.</p></article>\n        <article class=\"fitout-scope-card\" data-anim=\"\"><h3>Air Conditioning</h3><p>Split units, FCUs, ducting, drains and ceiling coordination.</p></article>\n        <article class=\"fitout-scope-card\" data-anim=\"\"><h3>Joinery</h3><p>Reception desks, workstations, storage, meeting tables and pantry units.</p></article>\n        <article class=\"fitout-scope-card\" data-anim=\"\"><h3>Furniture</h3><p>Desks, chairs, meeting tables, lockers, lounge and reception seating.</p></article>\n        <article class=\"fitout-scope-card\" data-anim=\"\"><h3>Painting</h3><p>Emulsion, texture, wall panels, feature finishes and door finishing.</p></article>\n        <article class=\"fitout-scope-card\" data-anim=\"\"><h3>Signage</h3><p>Entrance signs, room names, wayfinding and branded wall elements.</p></article>\n        <article class=\"fitout-scope-card\" data-anim=\"\"><h3>Project Management</h3><p>BOQ, schedule, procurement, trade sequencing, quality checks and warranty.</p></article>\n      </div></div>\n      <div class=\"fitout-scope-controls\"><span class=\"fitout-scope-status\" id=\"fitout-scope-status\" aria-live=\"polite\">01 / 12</span><div class=\"fitout-scope-dots\" id=\"fitout-scope-dots\" aria-label=\"Choose fit-out service slide\"><button type=\"button\" class=\"fitout-scope-dot\" aria-label=\"Show fit-out services starting at item 1\" aria-current=\"true\"></button><button type=\"button\" class=\"fitout-scope-dot\" aria-label=\"Show fit-out services starting at item 2\" aria-current=\"false\"></button><button type=\"button\" class=\"fitout-scope-dot\" aria-label=\"Show fit-out services starting at item 3\" aria-current=\"false\"></button><button type=\"button\" class=\"fitout-scope-dot\" aria-label=\"Show fit-out services starting at item 4\" aria-current=\"false\"></button><button type=\"button\" class=\"fitout-scope-dot\" aria-label=\"Show fit-out services starting at item 5\" aria-current=\"false\"></button><button type=\"button\" class=\"fitout-scope-dot\" aria-label=\"Show fit-out services starting at item 6\" aria-current=\"false\"></button><button type=\"button\" class=\"fitout-scope-dot\" aria-label=\"Show fit-out services starting at item 7\" aria-current=\"false\"></button><button type=\"button\" class=\"fitout-scope-dot\" aria-label=\"Show fit-out services starting at item 8\" aria-current=\"false\"></button><button type=\"button\" class=\"fitout-scope-dot\" aria-label=\"Show fit-out services starting at item 9\" aria-current=\"false\"></button><button type=\"button\" class=\"fitout-scope-dot\" aria-label=\"Show fit-out services starting at item 10\" aria-current=\"false\"></button></div><button class=\"fitout-scope-btn\" id=\"fitout-scope-prev\" type=\"button\" aria-label=\"Previous fit-out services\" disabled=\"\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"></path></svg></button><button class=\"fitout-scope-btn\" id=\"fitout-scope-next\" type=\"button\" aria-label=\"Next fit-out services\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg></button></div></div>\n    </div></section>"
 },
 {
  "id": "3bc0e6ea93",
  "type": "raw",
  "html": "\n\n    <section class=\"fitout-section navy-block\" id=\"fitout-process\" style=\"--fitout-process-progress: 1;\"><div class=\"wrap\">\n      <header class=\"fitout-section-head\" data-anim=\"\"><p class=\"eyebrow\">A clear route to handover</p><h2>Office Fit-Out Process, Step by Step</h2><p class=\"lead\">Eight practical stages, with scope and price agreed before site work begins.</p></header>\n      <div class=\"fitout-process-wrap\"><div class=\"fitout-process-rail\" aria-hidden=\"true\"><span></span></div><div class=\"fitout-process\" data-anim=\"\">\n        <article class=\"fitout-step is-active\"><h3>Site survey</h3><p>We measure the space and review existing structure, services and access.</p></article>\n        <article class=\"fitout-step is-active\"><h3>Layout planning</h3><p>Rooms, workstations and circulation are set around your team.</p></article>\n        <article class=\"fitout-step is-active\"><h3>BOQ and price</h3><p>Every agreed item, milestone and date is written into the scope.</p></article>\n        <article class=\"fitout-step is-active\"><h3>Material selection</h3><p>You approve partition, ceiling, flooring, lighting and joinery finishes.</p></article>\n        <article class=\"fitout-step is-active\"><h3>Site execution</h3><p>All trades are sequenced and supervised by the Woodex project team.</p></article>\n        <article class=\"fitout-step is-active\"><h3>Furniture install</h3><p>Joinery, workstations, seating and storage are fitted into place.</p></article>\n        <article class=\"fitout-step is-active\"><h3>Snagging</h3><p>We test services and correct every item before completion.</p></article>\n        <article class=\"fitout-step is-active\"><h3>Handover</h3><p>The office is cleaned, tested and ready for your team to move in.</p></article>\n      </div></div>\n      <div class=\"fitout-timeline-note\" data-anim=\"\"><p><strong>Typical timeline:</strong> 3 to 6 weeks for a 1,000 to 3,000 sq. ft. office, subject to scope, materials and building access.</p><a class=\"btn\" href=\"/turnkey-design-build/\">See turnkey service</a></div>\n    </div></section>"
 },
