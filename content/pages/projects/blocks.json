  "type": "hero",
  "html": "\n\n    <section class=\"hx-hero\" aria-labelledby=\"projects-hero-title\">\n      <div class=\"hx-wrap\">\n        <p class=\"hx-kicker\" data-ph-reveal=\"\">Design studies</p>\n        <h1 id=\"projects-hero-title\" data-ph-reveal=\"\">Studies in how spaces work.</h1>\n        <p class=\"hx-intro\" data-ph-reveal=\"\">Six anonymous studies in homes, clinics, shops, offices and cafés, each thought through to a buildable plan.</p>\n      </div>\n      <div class=\"hx-wordmark\" aria-hidden=\"true\">PROJECTS</div>\n    </section>",
