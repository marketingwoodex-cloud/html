 {
  "id": "8f4279a750",
  "type": "raw",
  "html": "\n\n    <section class=\"hx-grid\" aria-label=\"Design studies\">\n      <div class=\"hx-wrap\">\n        <div class=\"hx-cards\">\n          <a class=\"hx-card\" href=\"/projects/courtyard-house/\" data-ph-reveal=\"\">\n            <figure><img src=\"/assets/img/img-27ed3ac85189.jpg\" alt=\"House courtyard view used as project photography placeholder\" width=\"2000\" height=\"1090\" loading=\"lazy\" decoding=\"async\"><span class=\"hx-date\">Study · 2026</span></figure>\n            <h3>A house around a courtyard</h3><p>An existing house re-planned so light and a small court reach every room.</p><span class=\"hx-more\">View the study</span>\n          </a>\n          <a class=\"hx-card\" href=\"/projects/clinic-fit-out/\" data-ph-reveal=\"\">\n            <figure><img src=\"/assets/img/img-5048d9095862.webp\" alt=\"Calm clinic waiting area used as project photography placeholder\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"><span class=\"hx-date\">Study · 2026</span></figure>\n            <h3>A clinic that calms</h3><p>Waiting, consult and procedure arranged for calm and easy cleaning.</p><span class=\"hx-more\">View the study</span>\n          </a>\n          <a class=\"hx-card\" href=\"/projects/retail-corner/\" data-ph-reveal=\"\">\n            <figure><img src=\"/assets/img/img-5194dc486e09.webp\" alt=\"Bright corner shop interior used as project photography placeholder\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"><span class=\"hx-date\">Study · 2026</span></figure>\n            <h3>A corner shop that stops footfall</h3><p>Entrance, display wall and checkout set out to turn footfall into sales.</p><span class=\"hx-more\">View the study</span>\n          </a>\n          <a class=\"hx-card\" href=\"/projects/small-apartment/\" data-ph-reveal=\"\">\n            <figure><img src=\"/assets/img/img-1f4b4ef86cb5.webp\" alt=\"Compact apartment living space used as project photography placeholder\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"><span class=\"hx-date\">Study · 2026</span></figure>\n            <h3>Sixty square metres, fully used</h3><p>One storage wall and clear sightlines make 60 square metres do three jobs.</p><span class=\"hx-more\">View the study</span>\n          </a>\n          <a class=\"hx-card\" href=\"/projects/office-floor/\" data-ph-reveal=\"\">\n            <figure><img src=\"/assets/img/img-1d6ad6c77d0f.webp\" alt=\"Open-plan office floor used as project photography placeholder\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"><span class=\"hx-date\">Study · 2026</span></figure>\n            <h3>One floor, three ways of working</h3><p>Focus rows, meeting rooms and a social edge balanced for daylight and quiet.</p><span class=\"hx-more\">View the study</span>\n          </a>\n          <a class=\"hx-card\" href=\"/projects/cafe-corner/\" data-ph-reveal=\"\">\n            <figure><img src=\"/assets/img/img-c7d3a3ebd62b.jpg\" alt=\"Corner café interior used as project photography placeholder\" width=\"1920\" height=\"1080\" loading=\"lazy\" decoding=\"async\"><span class=\"hx-date\">Study · 2026</span></figure>\n            <h3>A café that holds a crowd</h3><p>Counter flow, mixed seating and lighting built to survive daily service.</p><span class=\"hx-more\">View the study</span>\n          </a>\n        </div>\n      </div>\n    </section>"
 },
