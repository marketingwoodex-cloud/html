  "html": "\n\n    <section class=\"hub-hero\" aria-labelledby=\"fitout-hub-title\"><div class=\"wrap hub-hero-grid\">\n      <div class=\"hub-hero-copy\" data-hub-reveal=\"\"><nav class=\"crumbs\" aria-label=\"Breadcrumb\"><a href=\"/\">Home</a><span>→</span><span>Fit Out</span></nav><p class=\"hub-tag\">Lahore fit-out specialists</p><h1 id=\"fitout-hub-title\">Fit-Out &amp; Build in Lahore</h1><p class=\"lead\">From bare shell to finished space. One accountable team coordinates every trade, finish and final handover.</p><div class=\"actions\"><a class=\"btn\" href=\"#fitout-hub-contact\">Request a Fit-Out Quote</a><a class=\"btn btn-light\" href=\"https://wa.me/923224000768\">WhatsApp</a></div></div>\n      <figure class=\"hub-image hub-hero-media\" data-hub-reveal=\"\"><img src=\"/assets/img/img-1d6ad6c77d0f.webp\" alt=\"Contemporary completed office fit-out with workstations, meeting rooms and integrated lighting\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"><figcaption class=\"hub-hero-note\"><strong>Built for the way the space works</strong><span>Lahore · Office fit-out</span></figcaption></figure>\n    </div></section>",
