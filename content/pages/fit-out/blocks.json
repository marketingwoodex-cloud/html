  "id": "19fd70c609",
  "type": "raw",
  "html": "\n\n    <section class=\"hub-section\" id=\"fitout-hub-services\" aria-labelledby=\"fitout-subservices\"><div class=\"wrap\"><header class=\"hub-head\" data-hub-reveal=\"\"><h2 id=\"fitout-subservices\">Fit-out services for every commercial setting</h2><p>Explore seven dedicated services for offices, retail, hospitality, healthcare and full turnkey delivery.</p></header><div class=\"hub-services-shell\"><div class=\"hub-services-viewport\"><div class=\"hub-services-track\" id=\"hub-services-track\" style=\"transform: translate3d(0px,0,0);\">\n      <a class=\"hub-service\" href=\"/office-fit-out/\" data-page-route=\"officeFitout\"><div class=\"hub-image hub-service-media\"><img src=\"/assets/img/img-1d6ad6c77d0f.webp\" alt=\"Contemporary Woodex office fit-out\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"></div><div class=\"hub-service-body\"><small>Workplace</small><h3>Office Fit-Out</h3><p>Workplaces built from shell to ready for the team.</p><div class=\"hub-service-foot\"><span>Explore service</span></div></div></a>\n      <a class=\"hub-service\" href=\"/commercial-fit-out/\" data-page-route=\"fitoutService\"><div class=\"hub-image hub-service-media\"><img src=\"/assets/img/img-1d6ad6c77d0f.webp\" alt=\"Commercial interior project image placeholder\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"></div><div class=\"hub-service-body\"><small>Business</small><h3>Commercial Fit-Out</h3><p>Complete interiors for customer-facing and operational spaces.</p><div class=\"hub-service-foot\"><span>Explore service</span></div></div></a>\n      <a class=\"hub-service\" href=\"/restaurant-fit-out/\" data-page-route=\"fitoutService\"><div class=\"hub-image hub-service-media\"><img src=\"/assets/img/img-6f26e32ab200.webp\" alt=\"Restaurant fit-out project image placeholder\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"></div><div class=\"hub-service-body\"><small>Hospitality</small><h3>Restaurant Fit-Out</h3><p>Dining, kitchen and service areas coordinated together.</p><div class=\"hub-service-foot\"><span>Explore service</span></div></div></a>\n      <a class=\"hub-service\" href=\"/retail-fit-out/\" data-page-route=\"fitoutService\"><div class=\"hub-image hub-service-media\"><img src=\"/assets/img/img-c693554a31d5.webp\" alt=\"Retail showroom fit-out project image placeholder\" width=\"2048\" height=\"1024\" loading=\"lazy\" decoding=\"async\"></div><div class=\"hub-service-body\"><small>Retail</small><h3>Retail Fit-Out</h3><p>Displays, lighting, counters and branded finishes.</p><div class=\"hub-service-foot\"><span>Explore service</span></div></div></a>\n      <a class=\"hub-service\" href=\"/healthcare-fit-out/\" data-page-route=\"fitoutService\"><div class=\"hub-image hub-service-media\"><img src=\"/assets/img/img-fcc680fef653.webp\" alt=\"Healthcare interior project image placeholder\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"></div><div class=\"hub-service-body\"><small>Healthcare</small><h3>Healthcare Fit-Out</h3><p>Durable, practical spaces with coordinated specialist services.</p><div class=\"hub-service-foot\"><span>Explore service</span></div></div></a>\n      <a class=\"hub-service\" href=\"/pharmacy-fit-out/\" data-page-route=\"fitoutService\"><div class=\"hub-image hub-service-media\"><img src=\"/assets/img/img-f655d51401e8.webp\" alt=\"Pharmacy interior joinery project image placeholder\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"></div><div class=\"hub-service-body\"><small>Pharmacy</small><h3>Pharmacy Fit-Out</h3><p>Counters, shelving, storage, lighting and customer flow.</p><div class=\"hub-service-foot\"><span>Explore service</span></div></div></a>\n      <a class=\"hub-service\" href=\"/turnkey-design-build/\" data-page-route=\"fitoutService\"><div class=\"hub-image hub-service-media\"><img src=\"/assets/img/img-dce06249b137.webp\" alt=\"Turnkey design and build project image placeholder\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"></div><div class=\"hub-service-body\"><small>Complete package</small><h3>Turnkey Design Build</h3><p>Design and construction managed under one accountable team.</p><div class=\"hub-service-foot\"><span>Explore service</span></div></div></a>\n    </div></div><div class=\"hub-slider-controls\"><span class=\"hub-slider-status\" id=\"hub-services-status\" aria-live=\"polite\">01 / 07</span><button class=\"hub-slider-btn\" id=\"hub-services-prev\" type=\"button\" aria-label=\"Previous fit-out service\" disabled=\"\">←</button><button class=\"hub-slider-btn\" id=\"hub-services-next\" type=\"button\" aria-label=\"Next fit-out service\">→</button></div></div></div></section>"
 },
