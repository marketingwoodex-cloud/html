 {
  "id": "4a5a5b829d",
  "type": "raw",
  "html": "\n\n    <section class=\"ct-cards-section\" id=\"contact-cards\" aria-label=\"Contact Woodex\"><div class=\"ct-wrap ct-cards\" data-contact-reveal=\"\">\n      <a class=\"ct-card\" href=\"tel:+923224000768\"><svg class=\"ct-icon\" viewBox=\"0 0 32 32\" aria-hidden=\"true\"><path d=\"M10 6h4l2 6-3 2c1.5 3.1 3.9 5.5 7 7l2-3 6 2v4c0 1.7-1.3 3-3 3C14 26.5 5.5 18 5 7c0-1.7 1.3-3 3-3h2Z\"></path></svg><h2>Call the studio</h2><p>+92 322 4000768<br>+92 321 4686884</p></a>\n      <a class=\"ct-card\" href=\"https://wa.me/923224000768\"><svg class=\"ct-icon\" viewBox=\"0 0 32 32\" aria-hidden=\"true\"><path d=\"M6 26l1.7-5A11 11 0 1 1 12 25.3L6 26Z\"></path><path d=\"M12 11c.8 4 3.2 6.4 7 7\"></path></svg><h2>WhatsApp</h2><p>Chat with Woodex</p></a>\n      <a class=\"ct-card\" href=\"mailto:info@woodex.com.pk\"><svg class=\"ct-icon\" viewBox=\"0 0 32 32\" aria-hidden=\"true\"><rect x=\"5\" y=\"8\" width=\"22\" height=\"16\" rx=\"2\"></rect><path d=\"m6 10 10 8 10-8\"></path></svg><h2>Email</h2><p>info@woodex.com.pk</p></a>\n      <div class=\"ct-card\"><svg class=\"ct-icon\" viewBox=\"0 0 32 32\" aria-hidden=\"true\"><circle cx=\"16\" cy=\"16\" r=\"11\"></circle><path d=\"M16 10v7l5 3\"></path></svg><h2>Opening hours</h2><p><strong>Mon–Sat 9:30 AM – 6:30 PM</strong><br>Sunday closed</p></div>\n    </div></section>"
 },
 {
  "id": "2eee0e964e",
  "type": "cta",
  "html": "\n\n    <section class=\"ct-section ct-visit\" id=\"contact-visit\"><div class=\"ct-wrap ct-visit-grid\">\n      <div class=\"ct-visit-copy\" data-contact-reveal=\"\"><p class=\"ct-label\">Visit us</p><h2>Woodex Interior, Lahore.</h2><div class=\"ct-rule\" aria-hidden=\"true\"></div><address class=\"ct-address\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z\"></path><circle cx=\"12\" cy=\"10\" r=\"2.5\"></circle></svg>M-71, Zainab Tower<br>Model Town Link Road<br>Lahore, Pakistan</address><p>Parking is available at the tower. If you are bringing drawings, call ahead so a designer is free to sit with you.</p><div class=\"ct-hours\"><span class=\"ct-dot\" aria-hidden=\"true\"></span><strong>Mon–Sat 9:30–6:30</strong></div><div class=\"ct-actions\"><a class=\"btn\" href=\"https://wa.me/923224000768\">Message on WhatsApp</a><a class=\"btn btn-secondary\" href=\"/3d-visualization/\">View our work</a></div></div>\n      <div class=\"ct-visit-form\" data-contact-reveal=\"\">\n        <form class=\"ct-form\" id=\"visit-form\" novalidate>\n          <h3>Send an enquiry</h3>\n          <p class=\"ct-form-sub\">Tell us a little about the space and we will call you back.</p>\n          <div class=\"ct-field\"><label for=\"cf-name\">Name</label><input id=\"cf-name\" name=\"name\" type=\"text\" autocomplete=\"name\" required></div>\n          <div class=\"ct-field-row\">\n            <div class=\"ct-field\"><label for=\"cf-phone\">Phone</label><input id=\"cf-phone\" name=\"phone\" type=\"tel\" autocomplete=\"tel\" required></div>\n            <div class=\"ct-field\"><label for=\"cf-email\">Email</label><input id=\"cf-email\" name=\"email\" type=\"email\" autocomplete=\"email\"></div>\n          </div>\n          <div class=\"ct-field\"><label for=\"cf-type\">Project type</label><select id=\"cf-type\" name=\"type\">\n            <option>Interior design</option><option>Fit-out</option><option>Renovation</option>\n            <option>Architecture</option><option>3D visualization</option><option>Furniture</option><option>Something else</option>\n          </select></div>\n          <div class=\"ct-field\"><label for=\"cf-msg\">About the space</label><textarea id=\"cf-msg\" name=\"message\" rows=\"4\" placeholder=\"Location, approximate size, what you want done\"></textarea></div>\n          <input type=\"text\" id=\"cf-hp\" name=\"_hp\" tabindex=\"-1\" autocomplete=\"off\" style=\"position:absolute;left:-9999px\" aria-hidden=\"true\" />\n          <button class=\"btn\" type=\"submit\">Send enquiry</button>\n          <p class=\"ct-form-note\">Prefer talking? Call <a href=\"tel:+923224000768\">+92 322 4000768</a>.</p>\n          <p class=\"ct-form-status\" id=\"cf-status\" style=\"display:none;margin-top:12px;font-size:14px\"></p>\n        </form>\n      </div>\n    </div></section>",
