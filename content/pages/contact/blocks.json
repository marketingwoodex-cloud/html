  "type": "hero",
  "html": "\n\n    <section class=\"ct-hero\" aria-labelledby=\"contact-hero-title\">\n      <figure class=\"ct-hero-media\" aria-hidden=\"true\"><img src=\"/assets/img/img-1d6ad6c77d0f.webp\" alt=\"\" width=\"1920\" height=\"1280\" loading=\"lazy\" decoding=\"async\"></figure>\n      <div class=\"ct-wrap ct-hero-grid\">\n        <div class=\"ct-hero-copy\" data-contact-reveal=\"\">\n          <nav class=\"crumbs\" aria-label=\"Breadcrumb\"><a href=\"/\">Home</a><span>→</span><span>Contact</span></nav>\n          <p class=\"ct-label\">Contact</p>\n          <h1 id=\"contact-hero-title\">Let’s talk about your space</h1>\n        </div>\n        <div class=\"ct-hero-aside\" data-contact-reveal=\"\">\n          <p>Based in Lahore, working across Islamabad, Karachi and nationwide. Tell us what you need and we will respond with next steps.</p>\n          <a class=\"btn\" href=\"#contact-cards\">Start your project</a>\n        </div>\n      </div>\n    </section>",
