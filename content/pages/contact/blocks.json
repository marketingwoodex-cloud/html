 {
  "id": "a2408a3d79",
  "type": "raw",
  "html": "\n\n    <section class=\"ct-process ct-dark\" id=\"contact-process\"><div class=\"ct-wrap\">\n      <div class=\"ct-process-head\" data-contact-reveal=\"\"><h2>From first conversation to handover.</h2><p>Most enquiries get a response the same working day. For fit-out and renovation we usually propose a site visit before quoting.</p></div>\n      <div class=\"ct-steps\" data-contact-reveal=\"\">\n        <article class=\"ct-step\"><strong>01</strong><h3>Tell us about the space</h3><p>Share location, approximate area, use and timeline.</p></article>\n        <article class=\"ct-step\"><strong>02</strong><h3>Site visit or drawings review</h3><p>We assess condition, services and what can be reused.</p></article>\n        <article class=\"ct-step\"><strong>03</strong><h3>Concept &amp; quantities</h3><p>Layouts, 3D views and a costed scope you can compare.</p></article>\n        <article class=\"ct-step\"><strong>04</strong><h3>Build &amp; handover</h3><p>One team on site, one snag list, one completion date.</p></article>\n      </div>\n    </div></section>"
 },
 {
